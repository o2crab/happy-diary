{
    "permissions": {
        "allow": [
            "Bash(mise run check*)",
            "Bash(mise run test*)",
            "Bash(mise run lint*)",
            "Bash(mise run api:*)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./secrets/**)",
            "Read(./backend/data/**)",
            "Bash(docker *)",
            "Bash(git push *)",
            "Bash(git commit *--no-verify*)",
            "Bash(git reset --hard*)",
            "Bash(git clean *)",
            "Bash(rm -rf *)"
        ],
        "ask": [
            "Edit(./mise.toml)",
            "Edit(./lefthook.yml)",
            "Edit(./.claude/hooks/**)",
            "Edit(./.claude/agents/**)",
            "Edit(./.github/workflows/**)",
            "Edit(./scripts/**)",
            "Edit(./ruff.toml)",
            "Edit(./frontend/biome.json)",
            "Edit(./frontend/tsconfig.json)",
            "Edit(./frontend/package.json)",
            "Edit(./frontend/pnpm-workspace.yaml)",
            "Edit(./backend/pyproject.toml)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\""
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\"",
                        "timeout": 600
                    }
                ]
            }
        ]
    },
    "sandbox": {
        "enabled": true,
        "failIfUnavailable": true,
        "allowUnsandboxedCommands": false,
        "autoAllowBashIfSandboxed": false,
        "filesystem": {
            "denyRead": [
                "./.env",
                "./.env.*",
                "./secrets",
                "./backend/data",
                "~/.ssh",
                "~/.aws"
            ]
        },
        "network": {
            "allowLocalBinding": true,
            "allowedDomains": [
                "registry.npmjs.org",
                "pypi.org",
                "files.pythonhosted.org"
            ]
        }
    }
}
